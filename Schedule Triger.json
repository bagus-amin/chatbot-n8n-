    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst now = new Date(\n  new Date().toLocaleString(\"en-US\", { timeZone: \"Asia/Jakarta\" })\n);\n\nconst postsToSend = [];\n\nfor (const item of items) {\n  const row = item.json;\n\n  const dateStr = row[\"Scheduled Date\"];\n  const timeStr = row[\"Scheduled Time\"];\n  const status = row[\"Status\"];\n\n  if ((!status || status === \"Pending\") && dateStr && timeStr) {\n\n    const [day, month, year] = dateStr.split(\"/\");\n\n    const scheduledTime = new Date(`${year}-${month}-${day}T${timeStr}`);\n\n    if (!isNaN(scheduledTime) && scheduledTime <= now) {\n\n      // 🔥 UPDATE STATUS DI SINI\n      item.json.Status = \"Pending\";\n\n      postsToSend.push(item);\n    }\n  }\n}\n\nreturn postsToSend;"
      },
