      "parameters": {
        "jsCode": "// 1. Ambil data hari dari Webhook\nconst daysRequested = parseInt($('Webhook').first().json.query.days) || 0;\n\n// 2. Ambil data Saldo dari Cari Data Karyawan\n// Pastikan nama kolom di Google Sheets adalah \"Saldo_Cuti\" (sesuaikan huruf besar/kecilnya)\nconst employeeData = $('Cari Data Karyawan').first().json;\nconst currentBalance = parseInt(employeeData.Saldo_Cuti) || 0;\n\n// 3. Hitung Saldo Baru\nconst newBalance = currentBalance - daysRequested;\n\n// 4. Kembalikan data lengkap agar bisa dipakai node Update Saldo Cuti\nreturn [{\n  json: {\n    Email: $('Webhook').item.json.query.email, // Memastikan email tetap terbawa\n    newBalance: newBalance\n  }\n}];"
      },
